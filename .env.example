# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_NOTIFICATION_EMAIL: Admin email to receive new user & project inquiry notifications
ADMIN_NOTIFICATION_EMAIL="tameemimran253@gmail.com"

# AUTH_SECRET: Secret for signing session tokens
AUTH_SECRET="tameem_nexus_studio_super_secret_jwt_key_2026"

# Optional Email Provider Key (Resend / SendGrid)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Tameem Nexus Studio <notifications@tameemnexus.com>"

# Optional OAuth Client IDs (Google & Facebook)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
